{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saltandlight",
  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // no_handle_cross_request_promise_resolution: works around a confirmed
  // upstream Prisma bug (prisma/prisma#28732) — under concurrent requests,
  // Prisma's default query batching resolves a promise from a different
  // request's I/O context than the one awaiting it, and without this flag
  // the Workers runtime kills that request as "hung", surfacing as random
  // 500s / unresponsive navigation whenever several pages load at once
  // (e.g. Next.js prefetching multiple links in the header/footer).
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  // Every page render makes several sequential Postgres queries to Supabase in Tokyo
  // (ap-northeast-1); Smart Placement runs the Worker near that database instead of
  // near the visitor once it measures that this is faster. Static assets still come
  // from the nearest edge. If admin › Thống kê truy cập starts showing the wrong
  // country/city for visitors, this is the line to remove.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },
  // Visitor analytics (admin › Thống kê truy cập). Writes are free-tier (100k/day) and never touch Postgres.
  "analytics_engine_datasets": [
    // Dataset name is used unquoted as the SQL table name — letters, digits and underscores only
    { "binding": "ANALYTICS_EVENT", "dataset": "sl_analytics" }
  ]
}
