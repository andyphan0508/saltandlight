+
+/**
+ * saltandlight patch: upstream fetches ANY url here, bypassing next.config's
+ * remotePatterns — an open proxy that also serves foreign HTML from our origin.
+ * Mirrors next.config.mjs remotePatterns; keep the two in sync.
+ */
+const isAllowedImageUrl = (u) =>
+    u.protocol === "https:" && u.hostname.endsWith(".supabase.co") && u.pathname.startsWith("/storage/v1/object/public/");
+async function fetchImage(imageUrl, request, env) {
+    if (imageUrl.startsWith("/") && !imageUrl.startsWith("//")) {
+        return env.ASSETS.fetch(new URL(imageUrl, request.url));
+    }
+    let target;
+    try {
+        target = new URL(imageUrl);
+    }
+    catch {
+        return new Response("Invalid image url", { status: 400 });
+    }
+    if (!isAllowedImageUrl(target)) {
+        return new Response("Image host not allowed", { status: 400 });
+    }
+    // Cloudflare Image Transformations: resized to the srcset width (`w`) and re-encoded to AVIF/WebP
+    // when the browser takes it. Where Transformations isn't enabled on the zone the resized fetch
+    // fails or comes back as the original, so the plain fetch stays as the fallback.
+    const params = new URL(request.url).searchParams;
+    const accept = request.headers.get("accept") ?? "";
+    const image = {
+        width: clampInt(params.get("w"), 16, 3840),
+        quality: clampInt(params.get("q"), 1, 100) ?? 75,
+        fit: "scale-down",
+        format: accept.includes("image/avif") ? "avif" : accept.includes("image/webp") ? "webp" : undefined,
+    };
+    let res = await fetch(target, { cf: { cacheEverything: true, image } });
+    if (!isRasterImage(res)) {
+        res = await fetch(target, { cf: { cacheEverything: true } });
+    }
+    if (!isRasterImage(res)) {
+        return new Response("Not an image", { status: 400 });
+    }
+    const headers = new Headers(res.headers);
+    // The encoding depends on Accept, so browsers and proxies must not share one copy across it
+    headers.append("Vary", "Accept");
+    return new Response(res.body, { status: res.status, headers });
+}
+// SVG can carry script, so only raster images pass
+const isRasterImage = (res) => {
+    const type = res.headers.get("content-type") ?? "";
+    return res.ok && type.startsWith("image/") && !type.includes("svg");
+};
+const clampInt = (value, min, max) => {
+    const n = Number.parseInt(value ?? "", 10);
+    return Number.isFinite(n) ? Math.min(Math.max(n, min), max) : undefined;
+};
