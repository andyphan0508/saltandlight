<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fcf8f3"/>
      <stop offset="100%" stop-color="#faedd9"/>
    </linearGradient>
    <filter id="shadow3" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#3d2a14" flood-opacity="0.08"/>
    </filter>
  </defs>
  <rect width="800" height="1000" fill="url(#bg3)"/>
  
  <g transform="translate(100, 100)" filter="url(#shadow3)">
    <path d="M 180 60 Q 300 110 420 60 L 560 160 L 490 280 L 430 240 L 440 680 Q 300 700 160 680 L 170 240 L 110 280 L 40 160 Z" fill="#242426"/>
    <path d="M 230 65 Q 300 120 370 65" fill="none" stroke="#333338" stroke-width="4"/>
    
    <g transform="translate(300, 320)" text-anchor="middle">
      <!-- Crown symbol -->
      <path d="M -25 -30 L -35 -60 L -10 -45 L 0 -68 L 10 -45 L 35 -60 L 25 -30 Z" fill="#d97706"/>
      <text y="30" font-family="system-ui, -apple-system, sans-serif" font-size="32" font-weight="900" fill="#ffffff" letter-spacing="4">SEEK FIRST</text>
      <text y="65" font-family="system-ui, -apple-system, sans-serif" font-size="22" font-weight="800" fill="#f59e0b" letter-spacing="6">THE KINGDOM</text>
      <text y="100" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#a1a1aa" letter-spacing="3">MATTHEW 6:33</text>
    </g>
  </g>
  
  <rect x="40" y="40" width="130" height="34" rx="17" fill="#d97706"/>
  <text x="105" y="62" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">SALT &amp; LIGHT</text>
</svg>

