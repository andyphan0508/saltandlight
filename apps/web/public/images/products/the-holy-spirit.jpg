<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5f5f4"/>
      <stop offset="100%" stop-color="#e7e5e4"/>
    </linearGradient>
    <filter id="shadow2" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#000000" flood-opacity="0.08"/>
    </filter>
  </defs>
  <rect width="800" height="1000" fill="url(#bg2)"/>
  
  <!-- Shirt Silhouette Cream/White -->
  <g transform="translate(100, 100)" filter="url(#shadow2)">
    <path d="M 180 60 Q 300 110 420 60 L 560 160 L 490 280 L 430 240 L 440 680 Q 300 700 160 680 L 170 240 L 110 280 L 40 160 Z" fill="#fafafa"/>
    <path d="M 230 65 Q 300 120 370 65" fill="none" stroke="#e4e4e7" stroke-width="4"/>
    
    <g transform="translate(300, 320)" text-anchor="middle">
      <!-- Dove symbol -->
      <path d="M -20 -40 Q 0 -60 20 -40 Q 35 -30 15 -15 Q 0 -5 -20 -40 Z" fill="#1f5c3f" opacity="0.9"/>
      <text y="30" font-family="system-ui, -apple-system, sans-serif" font-size="34" font-weight="900" fill="#18181b" letter-spacing="4">THE HOLY SPIRIT</text>
      <text y="65" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#1f5c3f" letter-spacing="3">COMFORTER &amp; GUIDE</text>
      <text y="95" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#71717a">ĐỨC THÁNH LINH Ở CÙNG BẠN</text>
    </g>
  </g>
  
  <rect x="40" y="40" width="130" height="34" rx="17" fill="#1f5c3f"/>
  <text x="105" y="62" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">SALT &amp; LIGHT</text>
</svg>

