<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bg4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f0f7f6"/>
      <stop offset="100%" stop-color="#dcebe8"/>
    </linearGradient>
    <filter id="shadow4" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#0f2b26" flood-opacity="0.08"/>
    </filter>
  </defs>
  <rect width="800" height="1000" fill="url(#bg4)"/>
  
  <g transform="translate(100, 100)" filter="url(#shadow4)">
    <path d="M 180 60 Q 300 110 420 60 L 560 160 L 490 280 L 430 240 L 440 680 Q 300 700 160 680 L 170 240 L 110 280 L 40 160 Z" fill="#1c2423"/>
    <path d="M 230 65 Q 300 120 370 65" fill="none" stroke="#2c3735" stroke-width="4"/>
    
    <g transform="translate(300, 320)" text-anchor="middle">
      <circle cx="0" cy="-35" r="26" fill="none" stroke="#2dd4bf" stroke-width="2"/>
      <path d="M -15 -35 L 15 -35 M 0 -50 L 0 -20" stroke="#2dd4bf" stroke-width="3" stroke-linecap="round"/>
      <text y="30" font-family="system-ui, -apple-system, sans-serif" font-size="34" font-weight="900" fill="#ffffff" letter-spacing="5">WALK BY FAITH</text>
      <text y="65" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="700" fill="#2dd4bf" letter-spacing="4">NOT BY SIGHT</text>
      <text y="100" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#94a3b8" letter-spacing="3">2 CORINTHIANS 5:7</text>
    </g>
  </g>
  
  <rect x="40" y="40" width="130" height="34" rx="17" fill="#0f766e"/>
  <text x="105" y="62" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">SALT &amp; LIGHT</text>
</svg>

