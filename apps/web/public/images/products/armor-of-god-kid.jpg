<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff8f5"/>
      <stop offset="100%" stop-color="#feebe3"/>
    </linearGradient>
    <filter id="shadow5" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#8a3014" flood-opacity="0.08"/>
    </filter>
  </defs>
  <rect width="800" height="1000" fill="url(#bg5)"/>
  
  <!-- Baby Tee Silhouette -->
  <g transform="translate(130, 140)" filter="url(#shadow5)">
    <path d="M 160 50 Q 270 90 380 50 L 500 140 L 440 240 L 390 210 L 395 560 Q 270 580 145 560 L 150 210 L 100 240 L 40 140 Z" fill="#ffffff"/>
    <path d="M 200 55 Q 270 100 340 55" fill="none" stroke="#f43f5e" stroke-width="4"/>
    
    <g transform="translate(270, 270)" text-anchor="middle">
      <!-- Shield icon -->
      <path d="M 0 -50 Q 30 -50 30 -20 Q 30 25 0 45 Q -30 25 -30 -20 Q -30 -50 0 -50 Z" fill="#fb7185"/>
      <path d="M 0 -35 L 0 20 M -15 -10 L 15 -10" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>
      <text y="90" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="900" fill="#e11d48" letter-spacing="3">ARMOR OF GOD</text>
      <text y="125" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="700" fill="#fda4af" letter-spacing="3">LITTLE WARRIOR</text>
    </g>
  </g>
  
  <rect x="40" y="40" width="130" height="34" rx="17" fill="#e11d48"/>
  <text x="105" y="62" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">KIDS COLLECTION</text>
</svg>

