# ── Supabase / Database ──────────────────────────────────────────────
# Supabase project → Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) for DATABASE_URL (serverless-safe)
# and the "Session"/direct connection (port 5432) for DIRECT_URL (migrations).
# connection_limit should be >1 outside of a pure-serverless deployment —
# a long-running dev/prod server shares one Prisma Client across every
# request, so limiting it to 1 connection serializes all concurrent queries.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..." # server-only, never expose to the browser

# ── Email (order notifications) ──────────────────────────────────────
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Salt & Light <no-reply@saltandlight.com.vn>"
NOTIFY_ADMIN_EMAIL="saltandlight.lienhe@gmail.com"

# ── VietQR (bank transfer) ───────────────────────────────────────────
VIETQR_BANK_BIN="970436"        # e.g. Vietcombank BIN, see https://api.vietqr.io/v2/banks
VIETQR_ACCOUNT_NO="0000000000"
VIETQR_ACCOUNT_NAME="SALT AND LIGHT"

# ── Rate limiting (optional) ──────────────────────────────────────────
# Without these, apps/web falls back to a best-effort in-memory limiter —
# works with zero setup but resets per serverless instance. For accurate
# rate limiting across all Worker instances, create a free Upstash Redis
# database (upstash.com) and paste its REST credentials here.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── App URLs ──────────────────────────────────────────────────────────
# Single-domain deployment: admin lives at {SITE_URL}/admin on the same
# Worker, not a separate app/URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"

# ── WooCommerce migration (one-off, only needed to re-run scripts/src/migrate-woocommerce.ts) ──
WOO_COMMERCE_URL="https://saltandlight.com.vn"
WOO_COMMERCE_CONSUMER_KEY="ck_xxx"
WOO_COMMERCE_CONSUMER_SECRET="cs_xxx"
