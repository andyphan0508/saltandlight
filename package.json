{
  "name": "saltandlight",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @saltandlight/db generate",
    "db:migrate": "pnpm --filter @saltandlight/db migrate",
    "db:deploy": "pnpm --filter @saltandlight/db deploy",
    "db:seed": "pnpm --filter @saltandlight/db seed",
    "db:studio": "pnpm --filter @saltandlight/db studio",
    "db:restore": "pnpm --filter @saltandlight/scripts exec tsx src/restore-full-database.ts",
    "migrate:woocommerce": "pnpm --filter @saltandlight/scripts migrate:woocommerce",
    "bootstrap:owner": "pnpm --filter @saltandlight/scripts bootstrap:owner"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
