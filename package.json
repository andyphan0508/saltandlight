{
  "name": "saltandlight",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && pnpm --filter web build:cloudflare",
    "build:cloudflare": "pnpm --filter web build:cloudflare",
    "preview:cloudflare": "pnpm --filter web preview:cloudflare",
    "deploy:cloudflare": "pnpm --filter web deploy:cloudflare",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @saltandlight/db generate",
    "db:migrate": "pnpm --filter @saltandlight/db migrate",
    "db:deploy": "pnpm --filter @saltandlight/db deploy",
    "db:seed": "pnpm --filter @saltandlight/db seed",
    "db:studio": "pnpm --filter @saltandlight/db studio",
    "db:restore": "pnpm --filter @saltandlight/scripts exec tsx src/restore-full-database.ts",
    "migrate:woocommerce": "pnpm --filter @saltandlight/scripts migrate:woocommerce",
    "bootstrap:owner": "pnpm --filter @saltandlight/scripts bootstrap:owner"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@opennextjs/aws": "patches/@opennextjs__aws.patch"
    }
  }
}
